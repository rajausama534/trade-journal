NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI Coach (server only)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Live economic calendar (server only)
TRADING_ECONOMICS_API_KEY=your-trading-economics-api-key

# MT5 sync uses a per-connection token stored in Supabase.
# Never expose the Supabase service role key or provider keys in NEXT_PUBLIC_* variables.
